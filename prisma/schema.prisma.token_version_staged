generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id             String         @id @db.Uuid
  organizationId String?        @db.Uuid
  userId         String?        @db.Uuid
  action         String         @db.VarChar(100)
  entityType     String         @db.VarChar(100)
  entityId       String?        @db.Uuid
  oldValues      String?
  newValues      String?
  ipAddress      String?        @db.VarChar(45)
  userAgent      String?
  createdAt      DateTime       @default(now()) @db.Timestamp(6)
  organizations  organizations? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          users?         @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([userId])
}

model beds {
  id                   String                 @id @db.Uuid
  organizationId       String                 @db.Uuid
  propertyId           String                 @db.Uuid
  floorId              String                 @db.Uuid
  roomId               String                 @db.Uuid
  bedNumber            String                 @db.VarChar(50)
  status               BedStatus              @default(AVAILABLE)
  monthlyRent          Decimal                @db.Decimal(10, 2)
  deposit              Decimal                @db.Decimal(10, 2)
  notes                String?
  deletedAt            DateTime?              @db.Timestamp(6)
  createdAt            DateTime               @default(now()) @db.Timestamp(6)
  updatedAt            DateTime               @db.Timestamp(6)
  floors               floors                 @relation(fields: [floorId], references: [id], onDelete: Cascade)
  organizations        organizations          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties           properties             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms                rooms                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings             bookings[]
  maintenance_requests maintenance_requests[]
  move_ins             move_ins[]
  move_outs            move_outs[]
  resident_stays       resident_stays[]
  residents            residents[]

  @@unique([roomId, bedNumber])
  @@index([deletedAt])
  @@index([floorId])
  @@index([organizationId])
  @@index([propertyId])
  @@index([roomId])
  @@index([status])
}

model bookings {
  id             String        @id @db.Uuid
  organizationId String        @db.Uuid
  propertyId     String        @db.Uuid
  roomId         String        @db.Uuid
  bedId          String        @db.Uuid
  enquiryId      String?       @db.Uuid
  residentId     String?       @db.Uuid
  bookingAmount  Decimal       @db.Decimal(10, 2)
  bookingDate    DateTime      @default(now()) @db.Timestamp(6)
  expectedMoveIn DateTime      @db.Date
  receiptNumber  String        @db.VarChar(50)
  paymentMode    String        @default("UPI") @db.VarChar(50)
  status         BookingStatus @default(CONFIRMED)
  notes          String?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @db.Timestamp(6)
  beds           beds          @relation(fields: [bedId], references: [id], onDelete: Cascade)
  enquiries      enquiries?    @relation(fields: [enquiryId], references: [id])
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties     properties    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents      residents?    @relation(fields: [residentId], references: [id])
  rooms          rooms         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([bedId])
  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
}

model complaint_history {
  id          String           @id @db.Uuid
  complaintId String           @db.Uuid
  actorUserId String?          @db.Uuid
  oldStatus   ComplaintStatus?
  newStatus   ComplaintStatus
  notes       String?
  createdAt   DateTime         @default(now()) @db.Timestamp(6)
  complaints  complaints       @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model complaints {
  id                 String              @id @db.Uuid
  organizationId     String              @db.Uuid
  propertyId         String              @db.Uuid
  residentId         String              @db.Uuid
  ticketNumber       String              @unique @db.VarChar(50)
  category           ComplaintCategory   @default(OTHER)
  subject            String              @db.VarChar(200)
  description        String
  priority           MaintenancePriority @default(MEDIUM)
  status             ComplaintStatus     @default(SUBMITTED)
  assignedToId       String?             @db.Uuid
  investigationNotes String?
  resolutionNotes    String?
  resolvedAt         DateTime?           @db.Timestamp(6)
  closedAt           DateTime?           @db.Timestamp(6)
  createdAt          DateTime            @default(now()) @db.Timestamp(6)
  updatedAt          DateTime            @db.Timestamp(6)
  complaint_history  complaint_history[]
  users              users?              @relation(fields: [assignedToId], references: [id])
  organizations      organizations       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties         properties          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents          residents           @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([assignedToId])
  @@index([category])
  @@index([createdAt])
  @@index([organizationId])
  @@index([priority])
  @@index([propertyId])
  @@index([residentId])
  @@index([status])
}

model daily_menu_items {
  id               String       @id @db.Uuid
  weeklyMenuId     String       @db.Uuid
  dayOfWeek        DayOfWeek
  mealType         MealType
  title            String       @db.VarChar(150)
  itemsDescription String
  startTime        String?      @default("07:30") @db.VarChar(10)
  endTime          String?      @default("09:30") @db.VarChar(10)
  isSpecialMeal    Boolean      @default(false)
  createdAt        DateTime     @default(now()) @db.Timestamp(6)
  weekly_menus     weekly_menus @relation(fields: [weeklyMenuId], references: [id], onDelete: Cascade)

  @@index([dayOfWeek, mealType])
  @@index([weeklyMenuId])
}

model deposit_transactions {
  id              String        @id @db.Uuid
  organizationId  String        @db.Uuid
  propertyId      String        @db.Uuid
  residentId      String        @db.Uuid
  transactionType DepositTxType @default(COLLECTED)
  amount          Decimal       @db.Decimal(10, 2)
  transactionDate DateTime      @default(now()) @db.Timestamp(6)
  paymentMethod   PaymentMethod @default(UPI)
  referenceNumber String?       @db.VarChar(100)
  notes           String?
  createdAt       DateTime      @default(now()) @db.Timestamp(6)
  organizations   organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties      properties    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents       residents     @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId])
  @@index([residentId])
  @@index([transactionType])
}

model enquiries {
  id                String        @id @db.Uuid
  organizationId    String        @db.Uuid
  propertyId        String?       @db.Uuid
  name              String        @db.VarChar(150)
  phone             String        @db.VarChar(20)
  email             String?       @db.VarChar(255)
  source            EnquirySource @default(WEBSITE)
  preferredRoomType RoomType      @default(DOUBLE)
  budget            Decimal?      @db.Decimal(10, 2)
  expectedMoveIn    DateTime?     @db.Date
  status            EnquiryStatus @default(NEW)
  siteVisitDate     DateTime?     @db.Timestamp(6)
  notes             String?
  deletedAt         DateTime?     @db.Timestamp(6)
  createdAt         DateTime      @default(now()) @db.Timestamp(6)
  updatedAt         DateTime      @db.Timestamp(6)
  bookings          bookings[]
  organizations     organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties        properties?   @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
  @@index([phone])
  @@index([propertyId])
  @@index([status])
}

model expenses {
  id                String          @id @db.Uuid
  organizationId    String          @db.Uuid
  propertyId        String          @db.Uuid
  category          ExpenseCategory @default(ELECTRICITY_BILL)
  title             String          @db.VarChar(255)
  amount            Decimal         @db.Decimal(10, 2)
  expenseDate       DateTime        @default(now()) @db.Timestamp(6)
  paymentMethod     PaymentMethod   @default(UPI)
  vendorName        String?         @db.VarChar(150)
  invoiceReceiptUrl String?
  notes             String?
  recordedBy        String?         @db.Uuid
  deletedAt         DateTime?       @db.Timestamp(6)
  createdAt         DateTime        @default(now()) @db.Timestamp(6)
  updatedAt         DateTime        @db.Timestamp(6)
  organizations     organizations   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties        properties      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([deletedAt])
  @@index([expenseDate])
  @@index([organizationId])
  @@index([propertyId])
}

model floors {
  id             String           @id @db.Uuid
  organizationId String           @db.Uuid
  propertyId     String           @db.Uuid
  floorNumber    Int
  name           String           @db.VarChar(100)
  description    String?
  deletedAt      DateTime?        @db.Timestamp(6)
  createdAt      DateTime         @default(now()) @db.Timestamp(6)
  updatedAt      DateTime         @db.Timestamp(6)
  beds           beds[]
  organizations  organizations    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties     properties       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  resident_stays resident_stays[]
  residents      residents[]
  rooms          rooms[]
  staff_tasks    staff_tasks[]

  @@unique([propertyId, floorNumber])
  @@index([organizationId])
  @@index([propertyId])
}

model food_expenses {
  id               String        @id @db.Uuid
  organizationId   String        @db.Uuid
  propertyId       String        @db.Uuid
  vendorId         String?       @db.Uuid
  invoiceNumber    String?       @db.VarChar(100)
  amount           Decimal       @db.Decimal(10, 2)
  expenseDate      DateTime      @default(now()) @db.Timestamp(6)
  itemsDescription String
  paymentStatus    String        @default("PAID") @db.VarChar(50)
  paymentMethod    PaymentMethod @default(UPI)
  createdAt        DateTime      @default(now()) @db.Timestamp(6)
  organizations    organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties       properties    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  food_vendors     food_vendors? @relation(fields: [vendorId], references: [id])

  @@index([expenseDate])
  @@index([organizationId])
  @@index([propertyId])
  @@index([vendorId])
}

model food_vendors {
  id             String             @id @db.Uuid
  organizationId String             @db.Uuid
  propertyId     String?            @db.Uuid
  name           String             @db.VarChar(150)
  category       FoodVendorCategory @default(GROCERY_WHOLESALE)
  contactPerson  String?            @db.VarChar(100)
  phone          String             @db.VarChar(20)
  email          String?            @db.VarChar(255)
  address        String?
  gstin          String?            @db.VarChar(20)
  paymentTerms   String?            @default("Net 15 Days") @db.VarChar(100)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now()) @db.Timestamp(6)
  updatedAt      DateTime           @db.Timestamp(6)
  food_expenses  food_expenses[]
  organizations  organizations      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties     properties?        @relation(fields: [propertyId], references: [id])

  @@index([category])
  @@index([organizationId])
  @@index([propertyId])
}

model inventory_items {
  id                     String                   @id @db.Uuid
  organizationId         String                   @db.Uuid
  propertyId             String                   @db.Uuid
  name                   String                   @db.VarChar(200)
  sku                    String?                  @db.VarChar(50)
  category               InventoryCategory        @default(OTHER)
  unit                   InventoryUnit            @default(PCS)
  currentStock           Decimal                  @default(0.0) @db.Decimal(10, 2)
  minimumStock           Decimal                  @default(10.0) @db.Decimal(10, 2)
  maximumStock           Decimal                  @default(100.0) @db.Decimal(10, 2)
  purchasePrice          Decimal                  @default(0.0) @db.Decimal(10, 2)
  vendorId               String?                  @db.Uuid
  status                 InventoryStatus          @default(IN_STOCK)
  locationNote           String?                  @db.VarChar(150)
  createdAt              DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt              DateTime                 @db.Timestamp(6)
  organizations          organizations            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties             properties               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vendors                vendors?                 @relation(fields: [vendorId], references: [id])
  inventory_transactions inventory_transactions[]
  purchase_record_items  purchase_record_items[]

  @@index([category])
  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@index([vendorId])
}

model inventory_transactions {
  id                String                   @id @db.Uuid
  organizationId    String                   @db.Uuid
  propertyId        String                   @db.Uuid
  itemId            String                   @db.Uuid
  type              InventoryTransactionType
  quantity          Decimal                  @db.Decimal(10, 2)
  previousStock     Decimal                  @db.Decimal(10, 2)
  newStock          Decimal                  @db.Decimal(10, 2)
  unitPrice         Decimal?                 @db.Decimal(10, 2)
  totalAmount       Decimal?                 @db.Decimal(10, 2)
  referenceNumber   String?                  @db.VarChar(100)
  vendorId          String?                  @db.Uuid
  performedByUserId String?                  @db.Uuid
  notes             String?
  createdAt         DateTime                 @default(now()) @db.Timestamp(6)
  inventory_items   inventory_items          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  organizations     organizations            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users             users?                   @relation(fields: [performedByUserId], references: [id])
  properties        properties               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vendors           vendors?                 @relation(fields: [vendorId], references: [id])

  @@index([createdAt])
  @@index([itemId])
  @@index([organizationId])
  @@index([propertyId])
  @@index([type])
  @@index([vendorId])
}

model invoice_items {
  id          String     @id @db.Uuid
  invoiceId   String     @db.Uuid
  chargeType  ChargeType @default(BASE_RENT)
  description String     @db.VarChar(255)
  amount      Decimal    @db.Decimal(10, 2)
  isDeduction Boolean    @default(false)
  createdAt   DateTime   @default(now()) @db.Timestamp(6)
  invoices    invoices   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model invoices {
  id                  String                @id @db.Uuid
  organizationId      String                @db.Uuid
  propertyId          String                @db.Uuid
  residentId          String                @db.Uuid
  invoiceNumber       String                @unique @db.VarChar(50)
  billingPeriodStart  DateTime              @db.Date
  billingPeriodEnd    DateTime              @db.Date
  dueDate             DateTime              @db.Date
  baseRent            Decimal               @default(0.0) @db.Decimal(10, 2)
  additionalCharges   Decimal               @default(0.0) @db.Decimal(10, 2)
  lateFees            Decimal               @default(0.0) @db.Decimal(10, 2)
  discounts           Decimal               @default(0.0) @db.Decimal(10, 2)
  adjustments         Decimal               @default(0.0) @db.Decimal(10, 2)
  netPayable          Decimal               @db.Decimal(10, 2)
  paidAmount          Decimal               @default(0.0) @db.Decimal(10, 2)
  outstandingAmount   Decimal               @db.Decimal(10, 2)
  status              InvoiceStatus         @default(ISSUED)
  notes               String?
  issuedAt            DateTime              @default(now()) @db.Timestamp(6)
  paidAt              DateTime?             @db.Timestamp(6)
  createdAt           DateTime              @default(now()) @db.Timestamp(6)
  updatedAt           DateTime              @db.Timestamp(6)
  invoice_items       invoice_items[]
  organizations       organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties          properties            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents           residents             @relation(fields: [residentId], references: [id], onDelete: Cascade)
  payment_allocations payment_allocations[]

  @@index([dueDate])
  @@index([invoiceNumber])
  @@index([organizationId])
  @@index([propertyId])
  @@index([residentId])
  @@index([status])
}

model maintenance_history {
  id                   String               @id @db.Uuid
  maintenanceRequestId String               @db.Uuid
  actorUserId          String?              @db.Uuid
  oldStatus            MaintenanceStatus?
  newStatus            MaintenanceStatus
  notes                String?
  createdAt            DateTime             @default(now()) @db.Timestamp(6)
  maintenance_requests maintenance_requests @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)

  @@index([maintenanceRequestId])
}

model maintenance_requests {
  id                  String                @id @db.Uuid
  organizationId      String                @db.Uuid
  propertyId          String                @db.Uuid
  roomId              String?               @db.Uuid
  bedId               String?               @db.Uuid
  residentId          String?               @db.Uuid
  ticketNumber        String                @unique @db.VarChar(50)
  title               String                @db.VarChar(200)
  description         String
  category            MaintenanceCategory   @default(OTHER)
  priority            MaintenancePriority   @default(MEDIUM)
  status              MaintenanceStatus     @default(CREATED)
  assignedStaffId     String?               @db.Uuid
  vendorName          String?               @db.VarChar(150)
  estimatedCost       Decimal               @default(0.0) @db.Decimal(10, 2)
  actualCost          Decimal               @default(0.0) @db.Decimal(10, 2)
  images              String?
  resolutionNotes     String?
  slaDueAt            DateTime?             @db.Timestamp(6)
  assignedAt          DateTime?             @db.Timestamp(6)
  startedAt           DateTime?             @db.Timestamp(6)
  completedAt         DateTime?             @db.Timestamp(6)
  verifiedAt          DateTime?             @db.Timestamp(6)
  closedAt            DateTime?             @db.Timestamp(6)
  createdAt           DateTime              @default(now()) @db.Timestamp(6)
  updatedAt           DateTime              @db.Timestamp(6)
  maintenance_history maintenance_history[]
  users               users?                @relation(fields: [assignedStaffId], references: [id])
  beds                beds?                 @relation(fields: [bedId], references: [id])
  organizations       organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties          properties            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents           residents?            @relation(fields: [residentId], references: [id])
  rooms               rooms?                @relation(fields: [roomId], references: [id])

  @@index([assignedStaffId])
  @@index([bedId])
  @@index([category])
  @@index([createdAt])
  @@index([organizationId])
  @@index([priority])
  @@index([propertyId])
  @@index([residentId])
  @@index([roomId])
  @@index([status])
}

model managed_documents {
  id               String              @id @db.Uuid
  organizationId   String              @db.Uuid
  propertyId       String?             @db.Uuid
  residentId       String?             @db.Uuid
  title            String              @db.VarChar(255)
  category         DocumentCategory
  documentType     String              @db.VarChar(100)
  fileName         String              @db.VarChar(255)
  fileKey          String              @db.VarChar(255)
  fileUrl          String
  fileSize         Int                 @default(0)
  mimeType         String              @default("application/pdf") @db.VarChar(100)
  accessLevel      DocumentAccessLevel @default(ROLE_RESTRICTED)
  allowedRoles     String?             @db.VarChar(255)
  uploadedByUserId String?             @db.Uuid
  tags             String?             @db.VarChar(255)
  notes            String?
  createdAt        DateTime            @default(now()) @db.Timestamp(6)
  updatedAt        DateTime            @db.Timestamp(6)
  organizations    organizations       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties       properties?         @relation(fields: [propertyId], references: [id])
  residents        residents?          @relation(fields: [residentId], references: [id])
  users            users?              @relation(fields: [uploadedByUserId], references: [id])

  @@index([accessLevel])
  @@index([category])
  @@index([organizationId])
  @@index([propertyId])
  @@index([residentId])
}

model meal_attendances {
  id           String               @id @db.Uuid
  mealRecordId String               @db.Uuid
  residentId   String               @db.Uuid
  status       MealAttendanceStatus @default(PRESENT)
  markedAt     DateTime             @default(now()) @db.Timestamp(6)
  notes        String?
  meal_records meal_records         @relation(fields: [mealRecordId], references: [id], onDelete: Cascade)
  residents    residents            @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([mealRecordId, residentId])
  @@index([mealRecordId])
  @@index([residentId])
}

model meal_records {
  id               String             @id @db.Uuid
  organizationId   String             @db.Uuid
  propertyId       String             @db.Uuid
  mealDate         DateTime           @db.Date
  mealType         MealType
  expectedCount    Int                @default(0)
  actualCount      Int                @default(0)
  notes            String?
  loggedBy         String?            @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamp(6)
  updatedAt        DateTime           @db.Timestamp(6)
  meal_attendances meal_attendances[]
  organizations    organizations      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties       properties         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, mealDate, mealType])
  @@index([mealDate])
  @@index([organizationId])
  @@index([propertyId])
}

model move_ins {
  id                    String        @id @db.Uuid
  organizationId        String        @db.Uuid
  residentId            String        @db.Uuid
  propertyId            String        @db.Uuid
  bedId                 String        @db.Uuid
  moveInDate            DateTime      @default(now()) @db.Timestamp(6)
  initialMeterReading   Decimal?      @db.Decimal(10, 2)
  securityDepositAmount Decimal       @db.Decimal(10, 2)
  depositPaid           Decimal       @db.Decimal(10, 2)
  firstInvoiceAmount    Decimal       @db.Decimal(10, 2)
  firstInvoicePaid      Boolean       @default(false)
  status                MoveInStatus  @default(COMPLETED)
  notes                 String?
  checkedInBy           String?       @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamp(6)
  updatedAt             DateTime      @db.Timestamp(6)
  beds                  beds          @relation(fields: [bedId], references: [id], onDelete: Cascade)
  organizations         organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties            properties    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents             residents     @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([bedId])
  @@index([organizationId])
  @@index([residentId])
}

model move_outs {
  id                String        @id @db.Uuid
  organizationId    String        @db.Uuid
  residentId        String        @db.Uuid
  propertyId        String        @db.Uuid
  bedId             String?       @db.Uuid
  noticeDate        DateTime      @db.Timestamp(6)
  plannedMoveOut    DateTime      @db.Timestamp(6)
  actualMoveOut     DateTime?     @db.Timestamp(6)
  reason            String?
  totalDepositHeld  Decimal       @db.Decimal(10, 2)
  damageAmount      Decimal       @default(0.0) @db.Decimal(10, 2)
  damageNotes       String?
  pendingDuesAmount Decimal       @default(0.0) @db.Decimal(10, 2)
  depositDeductions Decimal       @default(0.0) @db.Decimal(10, 2)
  refundAmount      Decimal       @db.Decimal(10, 2)
  status            MoveOutStatus @default(NOTICE_SUBMITTED)
  settledAt         DateTime?     @db.Timestamp(6)
  settledBy         String?       @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamp(6)
  updatedAt         DateTime      @db.Timestamp(6)
  beds              beds?         @relation(fields: [bedId], references: [id])
  organizations     organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties        properties    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents         residents     @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([residentId])
  @@index([status])
}

model notices {
  id             String         @id @db.Uuid
  organizationId String         @db.Uuid
  propertyId     String?        @db.Uuid
  title          String         @db.VarChar(255)
  description    String
  audience       NoticeAudience @default(ALL_RESIDENTS)
  priority       NoticePriority @default(MEDIUM)
  publishDate    DateTime       @default(now()) @db.Timestamp(6)
  expiryDate     DateTime?      @db.Timestamp(6)
  status         NoticeStatus   @default(PUBLISHED)
  isPinned       Boolean        @default(false)
  authorUserId   String?        @db.Uuid
