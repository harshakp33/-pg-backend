  notes              String?
  checklistItems     String?
  createdAt          DateTime             @default(now()) @db.Timestamp(6)
  updatedAt          DateTime             @db.Timestamp(6)
  staff_task_history staff_task_history[]
  staff_profiles     staff_profiles?      @relation(fields: [assignedStaffId], references: [id])
  floors             floors?              @relation(fields: [floorId], references: [id])
  organizations      organizations        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties         properties           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms              rooms?               @relation(fields: [roomId], references: [id])

  @@index([assignedStaffId])
  @@index([category])
  @@index([dueDate])
  @@index([floorId])
  @@index([organizationId])
  @@index([propertyId])
  @@index([roomId])
  @@index([status])
}

model users {
  id                       String                     @id @db.Uuid
  email                    String                     @unique @db.VarChar(255)
  passwordHash             String                     @db.VarChar(255)
  firstName                String                     @db.VarChar(100)
  lastName                 String                     @db.VarChar(100)
  phone                    String                     @db.VarChar(20)
  avatarUrl                String?
  isActive                 Boolean                    @default(true)
  lastLoginAt              DateTime?                  @db.Timestamp(6)
  deletedAt                DateTime?                  @db.Timestamp(6)
  createdAt                DateTime                   @default(now()) @db.Timestamp(6)
  updatedAt                DateTime                   @db.Timestamp(6)
  audit_logs               audit_logs[]
  complaints               complaints[]
  inventory_transactions   inventory_transactions[]
  maintenance_requests     maintenance_requests[]
  managed_documents        managed_documents[]
  notices                  notices[]
  notification_preferences notification_preferences[]
  notifications            notifications[]
  organization_members     organization_members[]
  password_resets          password_resets[]
  refresh_tokens           refresh_tokens[]
  residents                residents[]
  staff_profiles           staff_profiles?
  visitors                 visitors[]

  @@index([email])
  @@index([isActive, deletedAt])
}

model vendors {
  id                     String                   @id @db.Uuid
  organizationId         String                   @db.Uuid
  name                   String                   @db.VarChar(200)
  contact                String                   @db.VarChar(100)
  phone                  String                   @db.VarChar(20)
  email                  String?                  @db.VarChar(255)
  category               VendorCategory           @default(GENERAL)
  address                String
  paymentTerms           VendorPaymentTerms       @default(NET_30)
  status                 VendorStatus             @default(ACTIVE)
  gstin                  String?                  @db.VarChar(30)
  bankDetails            String?
  notes                  String?
  createdAt              DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt              DateTime                 @db.Timestamp(6)
  inventory_items        inventory_items[]
  inventory_transactions inventory_transactions[]
  purchase_records       purchase_records[]
  organizations          organizations            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([organizationId])
  @@index([status])
}

model visitors {
  id               String         @id @db.Uuid
  organizationId   String         @db.Uuid
  propertyId       String         @db.Uuid
  residentId       String         @db.Uuid
  visitorName      String         @db.VarChar(150)
  phone            String         @db.VarChar(20)
  purpose          VisitorPurpose @default(FRIEND_VISIT)
  entryTime        DateTime?      @db.Timestamp(6)
  exitTime         DateTime?      @db.Timestamp(6)
  idType           VisitorIdType  @default(AADHAAR)
  idNumber         String?        @db.VarChar(50)
  vehicleNumber    String?        @db.VarChar(30)
  expectedDate     DateTime?      @db.Date
  notes            String?
  status           VisitorStatus  @default(EXPECTED)
  approvedByUserId String?        @db.Uuid
  rejectionReason  String?
  createdAt        DateTime       @default(now()) @db.Timestamp(6)
  updatedAt        DateTime       @db.Timestamp(6)
  users            users?         @relation(fields: [approvedByUserId], references: [id])
  organizations    organizations  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties       properties     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents        residents      @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([entryTime])
  @@index([expectedDate])
  @@index([organizationId])
  @@index([propertyId])
  @@index([residentId])
  @@index([status])
}

model weekly_menus {
  id               String             @id @db.Uuid
  organizationId   String             @db.Uuid
  propertyId       String             @db.Uuid
  name             String             @db.VarChar(150)
  weekStartDate    DateTime           @db.Date
  isPublished      Boolean            @default(true)
  notes            String?
  createdAt        DateTime           @default(now()) @db.Timestamp(6)
  updatedAt        DateTime           @db.Timestamp(6)
  daily_menu_items daily_menu_items[]
  organizations    organizations      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties       properties         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, weekStartDate])
  @@index([organizationId])
  @@index([propertyId])
}

